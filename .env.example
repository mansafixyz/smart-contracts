# Duplicate this as .env and fill it in before you deploy. The real one never
# gets committed.

# The account that sends the deployment transactions. Needs ETH on Robinhood
# Chain to cover gas.
PRIVATE_KEY=0x...

# Who is allowed to write KYC outcomes onto account records (AccountRegistry).
COMPLIANCE_AUTHORITY=0x...

# USDG, the Global Dollar, and the settlement asset this protocol is built
# around on Robinhood Chain. ConfidentialToken wraps it and agents spend it
# unless told otherwise.
USDG_ADDRESS=0x...

# The deployed Groth16 verifier for confidential transfers. Leave it empty and
# the bundled StubTransferVerifier goes in for bring-up instead; swap to the
# real one before anything of value is wrapped.
TRANSFER_VERIFIER_ADDRESS=

# The $MANSA token. Holding it, and staking it, is what lowers what an account
# pays in fees. Given this and a treasury, the deploy script also puts up the
# StakingVault and the FeeSchedule and points the protocol at them. Omit either
# variable and the deployment comes up with fees switched off entirely.
MANSA_ADDRESS=
# Where collected fees are sent.
TREASURY=

# Blockscout key for `forge verify-contract`. Blockscout often accepts a blank.
BLOCKSCOUT_API_KEY=
